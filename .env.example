# Required — Chat (gpt-4o) + Images (gpt-image-1 / images.edit) for text + AI bocetos
OPENAI_API_KEY=sk-...

# Optional fallback for AI bocetos if OpenAI Images fails
# https://fal.ai/dashboard/keys
FAL_KEY=

# Required to share routines across phones/browsers (Vercel → Storage → Blob)
# https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=
